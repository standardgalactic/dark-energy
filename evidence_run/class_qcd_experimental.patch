+/** experimental: cubic Hermite interpolation of the tabulated w(ln a); constant outside the table */
+static void background_tab_interp(struct background * pba, double lna, double * w, double * dw) {
+  int lo = 0, hi = pba->fld_tab_n-1, mid;
+  double x0, x1, hh, t, h00, h10, h01, h11;
+  if (lna <= pba->fld_tab_lna[0]) { *w = pba->fld_tab_w[0]; *dw = 0.; return; }
+  if (lna >= pba->fld_tab_lna[hi]) { *w = pba->fld_tab_w[hi]; *dw = 0.; return; }
+  while (hi-lo > 1) { mid = (lo+hi)/2; if (pba->fld_tab_lna[mid] > lna) hi = mid; else lo = mid; }
+  x0 = pba->fld_tab_lna[lo]; x1 = pba->fld_tab_lna[hi]; hh = x1-x0; t = (lna-x0)/hh;
+  h00 = (1.+2.*t)*(1.-t)*(1.-t); h10 = t*(1.-t)*(1.-t); h01 = t*t*(3.-2.*t); h11 = t*t*(t-1.);
+  *w = h00*pba->fld_tab_w[lo] + h10*hh*pba->fld_tab_dw[lo] + h01*pba->fld_tab_w[hi] + h11*hh*pba->fld_tab_dw[hi];
+  *dw = (6.*t*t-6.*t)/hh*pba->fld_tab_w[lo] + (3.*t*t-4.*t+1.)*pba->fld_tab_dw[lo]
+      + (-6.*t*t+6.*t)/hh*pba->fld_tab_w[hi] + (3.*t*t-2.*t)*pba->fld_tab_dw[hi];
+}
+
