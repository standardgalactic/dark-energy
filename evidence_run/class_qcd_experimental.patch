@@ -805,6 +838,24 @@ int background_w_fld(
   case CLP:
     *integral_fld = 3.*((1.+pba->w0_fld+pba->wa_fld)*log(1./a) + pba->wa_fld*(a-1.));
     break;
+  case TAB:
+    {
+      /* 3 * int_{ln a}^{0} (1+w) dln a', trapezoid, 4000 steps */
+      int k, nk = 4000;
+      double lna0 = (a > 0.) ? log(a) : pba->fld_tab_lna[0];
+      double dl, s = 0., w1, w2, d_;
